# OpenAI (primary)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4

# Anthropic (fallback when OpenAI returns 429)
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Pinecone — historical claims index
PINECONE_API_KEY=replace-me
PINECONE_INDEX=acme-claims-prod
PINECONE_REGION=us-east-1

# Redis — short-term conversation memory (per claimant CPF)
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_TTL=86400

# LangSmith — observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__replace-me
LANGCHAIN_PROJECT=acme-triage-prod

# Email notification gateway (for tool: notify_claimant_email)
SMTP_HOST=smtp.acme.example
SMTP_USER=noreply@acme.example
SMTP_PASSWORD=replace-me
